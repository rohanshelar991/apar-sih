# Copy to backend/.env (ignored). Spring Boot does NOT automatically load .env;
# use start-supabase.ps1, export these variables, or inject them through hosting/IDE.
SPRING_PROFILES_ACTIVE=postgres,render
PORT=10000
SERVER_ADDRESS=0.0.0.0
SUPABASE_PROJECT_REF=hxmlezblzvdbacebsmcb

# Required database settings; application identity must not own tables.
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&connectTimeout=15&socketTimeout=30
DB_USERNAME=apaar_app.hxmlezblzvdbacebsmcb
DB_PASSWORD=<app-password>

# Required separate schema-owner identity for Flyway.
FLYWAY_USER=apaar_migrator.hxmlezblzvdbacebsmcb
FLYWAY_PASSWORD=<migration-password>

DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# JWT_SECRET is a Base64-encoded random key (at least 48 random bytes).
JWT_SECRET=<base64-random-secret>
JWT_EXPIRY_MINUTES=60
# Reserved: current verification tokens are opaque random database tokens,
# not signed tokens; VERIFY_TOKEN_SECRET is not consumed by this application.
VERIFY_TOKEN_SECRET=<different-base64-random-secret>
VERIFY_TOKEN_TTL_MINUTES=15
CORS_ALLOWED_ORIGINS=https://<frontend-project>.vercel.app

# Production never seeds. For local/demo PostgreSQL use postgres,dev + true.
SEED_DEMO_DATA=false

# Docker Compose only: provisioner credentials, never application credentials.
POSTGRES_DB=apaar_connect
POSTGRES_USER=apaar_owner
POSTGRES_PASSWORD=<local-provisioner-password>
