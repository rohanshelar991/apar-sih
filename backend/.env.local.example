# Local-only PostgreSQL profile for start-local.sh. Copy to backend/.env.local.
# Use a new password for your machine; never reuse a hosted database credential.
POSTGRES_DB=apaar_connect
POSTGRES_USER=apaar_local
POSTGRES_PASSWORD=replace-with-a-local-only-password

DB_URL=jdbc:postgresql://localhost:5432/apaar_connect
DB_USERNAME=apaar_local
DB_PASSWORD=replace-with-a-local-only-password
FLYWAY_USER=apaar_local
FLYWAY_PASSWORD=replace-with-a-local-only-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-48-random-bytes-base64-encoded
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
